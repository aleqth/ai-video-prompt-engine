# AI Video & Prompt Generation Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# Google AI Studio / Gemini API Key (for Veo 3.1 & Veo 2.0 Video Generation)
# Get key: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Fal AI API Key (for Kling 1.6/3.0, Hedra Character-2, LatentSync, Sync-Lips)
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_ai_key_here

# Optional: Default output directory for generated videos
VIDEO_OUTPUT_DIR=./output_videos

# Optional: Default model parameters
DEFAULT_VIDEO_ASPECT_RATIO=9:16
DEFAULT_VIDEO_DURATION_SEC=5
